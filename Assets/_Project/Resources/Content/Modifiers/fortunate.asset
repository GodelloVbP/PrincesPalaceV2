  m_Name: fortunate
  m_EditorClassIdentifier: PrincesPalace.Core::PrincesPalace.Content.ModifierDefinition
  data:
    Id: fortunate
    DisplayName: Fortunate
    Description: 'The Prince favours whoever is wearing this, right now -- a flat,
      passive bonus to Prince''s Favor for as long as it stays equipped, nothing
      stored and nothing that outlives taking it off. Base 3 at Ordinary/tier-0 sits
      alongside Shawn''s own authored favour of 4: a meaningful nudge toward better
      drops, not a second currency to bank.'
    SortOrder: 19
    Effects:
    - Type: 14
      Magnitude: 2
      Threshold: 0
      AgainstType: 0
      HasAgainst: 0
      AgainstMagical: 0
