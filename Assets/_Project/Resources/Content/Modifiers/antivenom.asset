  data:
    Id: antivenom
    DisplayName: Antivenom
    Description: 'The wearer has long since built up a tolerance. Elemental family:
      Poison, the resistance half -- Venomous is Poison''s separate on-hit-sting
      affix. Split off Venomous''s old bundle so a roll grants one or the other,
      never both.'
    SortOrder: 9
    Effects:
    - Type: 2
      Magnitude: 8
      Threshold: 0
      AgainstType: 4
      HasAgainst: 1
      AgainstMagical: 0
