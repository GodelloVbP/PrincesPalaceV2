  m_Script: {fileID: 11500000, guid: 8eb37102d2241c54eae4db6c08bbb7c5, type: 3}
  m_Name: swift
  m_EditorClassIdentifier: PrincesPalace.Core::PrincesPalace.Content.ModifierDefinition
  data:
    Id: swift
    DisplayName: Swift
    Description: 'Phase D1''s dodge family. A step too quick for a swing or a cast
      to reliably land -- Magnitude is a dodge RATING, not a direct percent, run
      through CombatMath.DodgePercentFrom''s curve (100 * R / (R + 100), the same
      R/(R+100) shape as armour mitigation -- ''100 dodge = 50% chance to dodge'')
      before DamagePipeline.RollDodge rolls against it (see ModifierEffectType.DodgeRating
      for the full mechanics: zero damage, and every on-hit rider skipped with it).
      RENAMED from DodgeChancePercent, and the curve inserted, 2026-08-26: at a direct-percent
      reading, a maxed Swift item (base 12 x up to ~18.6x combined tier/rift scaling,
      ~223 raw) would have exceeded 100 outright -- a guaranteed, unavoidable dodge,
      which is exactly what the curve now prevents (that same ~223 rating instead
      reads as ~69%, per DamagePipeline''s own hand-computed table). Base 12 at Ordinary/tier-0
      curves to ~10.7%, close enough to the old flat 12% that it was left as-is rather
      than retuned. Already single-effect since Phase C; untouched by the affix split.'
    SortOrder: 24
    Effects:
    - Type: 15
      Magnitude: 6
      Threshold: 0
      AgainstType: 0
      HasAgainst: 0
      AgainstMagical: 0
