  m_Script: {fileID: 11500000, guid: 8eb37102d2241c54eae4db6c08bbb7c5, type: 3}
  m_Name: stalwart
  m_EditorClassIdentifier: PrincesPalace.Core::PrincesPalace.Content.ModifierDefinition
  id: stalwart
  displayName: Stalwart
  description: Armour plating a percentage curve cannot express, and a guard that
    gives less ground under pressure. FlatPhysicalDamageReduction's base (3) is small
    on purpose at Ordinary/tier-0 -- it is a FLAT subtraction, so it matters far
    more against the many small hits of a swarm than against one boss-sized blow,
    which is the intended shape (a Stalwart wearer shrugs off chip damage, not a
    haymaker). BreakShieldDepletionResistPercent (30) is forward-looking infrastructure
    -- no player combatant carries a BreakShield today, only some bosses/elites do,
    so this is inert on the wearer until a future fight puts one on the player's
    own side.
  effects:
  - type: 6
    magnitude: 3
    threshold: 0
    against: 0
    hasAgainst: 0
    againstMagical: 0
  - type: 7
    magnitude: 30
    threshold: 0
    against: 0
    hasAgainst: 0
    againstMagical: 0
  sortOrder: 7
