  m_Script: {fileID: 11500000, guid: 8eb37102d2241c54eae4db6c08bbb7c5, type: 3}
  m_Name: hardened
  m_EditorClassIdentifier: PrincesPalace.Core::PrincesPalace.Content.ModifierDefinition
  data:
    Id: hardened
    DisplayName: Hardened
    Description: 'A brute, physical edge on every hit. Elemental family: Physical,
      the damage half -- Ironclad is Physical''s resistance affix and Juggernaut
      is Physical''s stagger-proc affix, both split off this modifier''s old three-effect
      bundle (one of three families -- alongside Ice''s Frostbite and Nature''s Entangling
      -- that carries a third, proc effect beyond its damage and resistance halves;
      see Ironclad and Juggernaut''s own descriptions).'
    SortOrder: 12
    Effects:
    - Type: 1
      Magnitude: 10
      Threshold: 0
      AgainstType: 0
      HasAgainst: 1
      AgainstMagical: 0
