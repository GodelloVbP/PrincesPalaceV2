        {
          "id": "endure",
          "artPath": "Assets/_Project/Art/Events/bell_in_the_fog/endure.png",
          "title": "The Flock",
          "body": "",
          "cast": [ { "character": "sheep", "side": "left" } ],
          "lines": [
            { "speaker": "narration", "expression": "", "text": "On the tenth toll the Bellwether stops, and the flock stops behind it. Then, all together, they turn to look at him." },
            { "speaker": "narration", "expression": "", "text": "Every sheep in the flock is wearing his face. Not a face like his. His. Hundreds of him, patient in the fog, waiting to be counted." },
            { "speaker": "sheep", "expression": "entranced", "text": "...Oh." },
            { "speaker": "narration", "expression": "", "text": "The bell rings once more, very close, and Shawn opens his eyes. He is standing at the stump. His hoof has only just left the brass." },
            { "speaker": "sheep", "expression": "nervous", "text": "How long was I gone?" }
          ],
          "choices": [
            {
              "text": "Leave",
              "requires": [],
              "hiddenUntilMet": false,
              "effects": [],
              "outcomes": [
                {
                  "requires": [
                    { "kind": "inParty", "character": "bear", "alive": true },
                    { "kind": "inParty", "character": "owl", "alive": true }
                  ],
                  "effects": [],
                  "result": "\"Gone?\" Bjorn frowns. \"You touched it and let go.\" Odette nods: a second, no more. Neither of them hears the flock still walking behind the trees.",
                  "goTo": "Leave"
                },
                {
                  "requires": [ { "kind": "inParty", "character": "bear", "alive": true } ],
                  "effects": [],
                  "result": "\"Gone?\" Bjorn frowns. \"You touched it and let go. A second, no more.\" He does not hear the flock still walking behind the trees.",
                  "goTo": "Leave"
                },
                {
                  "requires": [ { "kind": "inParty", "character": "owl", "alive": true } ],
                  "effects": [],
                  "result": "Odette tilts her head. \"A second, Shawn. You touched it and let go.\" She does not hear the flock still walking behind the trees.",
                  "goTo": "Leave"
                },
                {
                  "requires": [],
                  "effects": [],
                  "result": "No one is standing to tell him. The fog does not say. Behind the trees, soft as breath, the flock is still walking.",
                  "goTo": "Leave"
                }
              ]
            }
          ]
