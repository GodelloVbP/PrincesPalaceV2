          "artPath": "Assets/_Project/Art/Events/bell_in_the_fog/stump_bell.png",
          "title": "The Bell in the Fog",
          "body": "",
          "cast": [ { "character": "sheep", "side": "left" } ],
          "lines": [
            { "speaker": "narration", "expression": "", "text": "There is no one standing to ask. The fog keeps its own counsel." },
            { "speaker": "sheep", "expression": "entranced", "text": "Just me, then. Just me and the bell." }
          ],
          "choices": [
            {
              "text": "Listen again",
