    {
      "id": "bell_in_the_fog",
      "mayReturn": true,
      "floors": [],
      "requires": [
        { "kind": "inParty", "character": "sheep", "alive": true }
      ],
      "backdrop": "Assets/_Project/Art/Events/bell_in_the_fog/fog_clearing.png",
      "pages": [
        {
          "id": "bell",
          "artPath": "Assets/_Project/Art/Events/bell_in_the_fog/stump_bell.png",
          "title": "The Bell in the Fog",
          "body": "",
          "cast": [ { "character": "sheep", "side": "left" } ],
          "lines": [
            { "speaker": "narration", "expression": "", "text": "The fog thickens until the trees are only shapes. Then a clearing the path never promised, and in it an old stump. On the stump, a bell." },
            { "speaker": "narration", "expression": "", "text": "Polished brass, not a fingerprint on it, hung from a new leather strap. Everything else in this forest is moss and rot. The bell is clean." },
            { "speaker": "sheep", "expression": "entranced", "text": "Do you hear it? It's ringing. Nobody's touching it, and it's ringing." },
            { "speaker": "narration", "expression": "", "text": "It makes no sound. The mist around it does not stir. Shawn has taken a step toward the stump, and does not seem to know it." },
            { "speaker": "sheep", "expression": "entranced", "text": "I think I'm meant to touch it. I don't know how I know that." },
            { "speaker": "narration", "expression": "", "text": "Past the trees, soft as breath, something is counting. It has lost its place before, and started again." }
          ],
          "choices": [
            {
              "text": "Touch the bell",
              "requires": [
                { "kind": "inParty", "character": "sheep", "alive": true }
              ],
              "hiddenUntilMet": false,
              "effects": [],
              "outcomes": [
                { "requires": [], "effects": [ { "kind": "fight", "fight": "bellwether" } ], "result": "", "goTo": "" }
              ]
            },
            {
              "text": "Ask the others",
              "requires": [],
              "hiddenUntilMet": false,
              "effects": [],
              "outcomes": [
                {
                  "requires": [
                    { "kind": "inParty", "character": "bear", "alive": true },
                    { "kind": "inParty", "character": "owl", "alive": true }
                  ],
                  "effects": [], "result": "", "goTo": "ask_both"
                },
                {
                  "requires": [ { "kind": "inParty", "character": "bear", "alive": true } ],
                  "effects": [], "result": "", "goTo": "ask_bjorn"
                },
                {
                  "requires": [ { "kind": "inParty", "character": "owl", "alive": true } ],
                  "effects": [], "result": "", "goTo": "ask_odette"
                },
                { "requires": [], "effects": [], "result": "", "goTo": "ask_none" }
              ]
            },
            {
              "text": "Walk away",
              "requires": [],
              "hiddenUntilMet": false,
              "effects": [],
              "outcomes": [
                { "requires": [], "effects": [], "result": "Shawn keeps looking back until the fog closes over the clearing. Nothing follows. The bell is patient.", "goTo": "Leave" }
              ]
            }
          ]
        },
        {
          "id": "ask_both",
          "artPath": "Assets/_Project/Art/Events/bell_in_the_fog/stump_bell.png",
          "title": "The Bell in the Fog",
          "body": "",
          "cast": [
            { "character": "sheep", "side": "left" },
            { "character": "bear", "side": "right" },
            { "character": "owl", "side": "right" }
          ],
          "lines": [
            { "speaker": "sheep", "expression": "entranced", "text": "You hear it. Tell me you hear it." },
            { "speaker": "bear", "expression": "neutral", "text": "Hear what, little one? It's a bell on a stump. It isn't doing a thing." },
            { "speaker": "owl", "expression": "neutral", "text": "There is no sound at all. No birds, either. I noticed the birds first." },
            { "speaker": "narration", "expression": "", "text": "Shawn looks from one to the other as if they were speaking to him through water." },
            { "speaker": "sheep", "expression": "entranced", "text": "It's so loud." }
          ],
          "choices": [
            {
              "text": "Listen again",
              "requires": [],
              "hiddenUntilMet": false,
              "effects": [],
              "outcomes": [
                { "requires": [], "effects": [], "result": "", "goTo": "bell" }
              ]
            }
          ]
        },
        {
          "id": "ask_bjorn",
          "artPath": "Assets/_Project/Art/Events/bell_in_the_fog/stump_bell.png",
          "title": "The Bell in the Fog",
          "body": "",
          "cast": [
            { "character": "sheep", "side": "left" },
            { "character": "bear", "side": "right" }
          ],
          "lines": [
            { "speaker": "sheep", "expression": "entranced", "text": "Bjorn. You hear it, don't you?" },
            { "speaker": "bear", "expression": "neutral", "text": "I hear wind, and you breathing hard. That's all. Say the word and we walk on." },
            { "speaker": "sheep", "expression": "entranced", "text": "It's so loud." }
          ],
          "choices": [
            {
              "text": "Listen again",
              "requires": [],
