        {
          "id": "break",
          "artPath": "Assets/_Project/Art/Events/bell_in_the_fog/bell_broken.png",
          "title": "The Broken Bell",
          "body": "",
          "cast": [ { "character": "sheep", "side": "left" } ],
          "lines": [
            { "speaker": "narration", "expression": "", "text": "The Bellwether folds into the fog without a sound, and the flock behind it goes too, like breath off glass." },
            { "speaker": "narration", "expression": "", "text": "Shawn is standing at the stump, hoof on the brass. Under it the bell cracks, one clean line from crown to lip. The tolling stops." },
            { "speaker": "sheep", "expression": "nervous", "text": "I didn't mean to. I only wanted it to stop." },
            { "speaker": "narration", "expression": "", "text": "The strap is still new. He takes the bell anyway. It is warm, as if someone had been holding it for a very long time." },
            { "speaker": "narration", "expression": "", "text": "Behind the trees, whatever was counting loses its place, and does not start again." }
          ],
