          "title": "The Bell in the Fog",
          "body": "",
          "cast": [
            { "character": "sheep", "side": "left" },
            { "character": "owl", "side": "right" }
          ],
          "lines": [
            { "speaker": "sheep", "expression": "entranced", "text": "Odette. You hear it, don't you?" },
            { "speaker": "owl", "expression": "nervous", "text": "I hear nothing, Shawn. That is what worries me. Even the fog has gone quiet." },
            { "speaker": "sheep", "expression": "entranced", "text": "It's so loud." }
          ],
          "choices": [
            {
              "text": "Listen again",
