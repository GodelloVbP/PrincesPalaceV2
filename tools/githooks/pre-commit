#!/bin/sh
#
# Pre-commit gate. Two checks, both of which turn a rule that CLAUDE.md could
# only ask for into one the repo enforces.
#
# Runtime is a few milliseconds: one `git ls-files` and one awk pass for the
# pairing check, plus one grep per staged .ps1. It does not run tests - the
# test gate stays `tools/run_tests_parallel.ps1`, deliberately, because a
# 90-second pre-commit hook is a hook people learn to bypass.
#
# Install (per clone, since core.hooksPath is local config and not committed):
#
#   git config core.hooksPath tools/githooks
#
# There is no project bypass flag, matching how run_tests_parallel.ps1 treats
# its area-coverage check. `git commit --no-verify` is a git builtin and cannot
# be removed, but reaching for it means the commit is wrong, not the hook.

set -u

TAB=$(printf '\t')
FAIL=0

fail() {
    printf '%s\n' "$*" >&2
    FAIL=1
}

TMPDIR_HOOK=$(mktemp -d) || exit 1
trap 'rm -rf "$TMPDIR_HOOK"' EXIT
INDEX_LIST="$TMPDIR_HOOK/index"
PAIR_LIST="$TMPDIR_HOOK/pairs"

# ---------------------------------------------------------------------------
# 1. Every asset under Assets/ commits together with its .meta.
#
# Gotcha #2 in CLAUDE.md: a missing .meta regenerates its GUID on the next
# fresh Library rebuild and orphans every reference to it. The failure is
# silent at commit time and only surfaces later, on someone else's machine or
# in a TestRunner copy - which is exactly the shape of bug worth mechanising.
#
# The test is on the INDEX, not on the staged diff, because the index is what
# the commit will actually contain: HEAD plus everything staged. So an asset
# that was already tracked and is untouched by this commit still counts as
# present, and an asset staged for deletion correctly counts as absent. That
# makes one rule cover additions, deletions and renames without special-casing
# any of them: after this commit, an asset exists if and only if its .meta does.
# ---------------------------------------------------------------------------

git ls-files > "$INDEX_LIST"

# Collect the asset-side path of every pair this commit touches. Renames report
# two paths on one line, so take both. Splitting on tab (not whitespace) matters
# - real paths here contain spaces, e.g. "ChakraPetch-Regular SDF.asset".
: > "$PAIR_LIST"
git diff --cached --name-status -M | while IFS="$TAB" read -r _status a b; do
    for p in "$a" "$b"; do
        [ -n "$p" ] || continue
        case "$p" in
            Assets/*) ;;
            *) continue ;;
        esac
        case "$p" in
            *.meta) asset=${p%.meta} ;;
            *) asset=$p ;;
        esac
        # -d is a shell builtin, so resolving folder metas here costs nothing.
        # Folder metas pair with a directory, which git never tracks itself.
        if [ -d "$asset" ]; then
            printf 'dir%s%s\n' "$TAB" "$asset"
        else
            printf 'file%s%s\n' "$TAB" "$asset"
        fi
    done
done | sort -u > "$PAIR_LIST"

if [ -s "$PAIR_LIST" ]; then
    PAIR_ERRORS=$(awk -F'\t' '
        NR == FNR { idx[$0] = 1; next }
        {
            kind = $1; asset = $2; meta = asset ".meta"
            have_asset = (kind == "dir") || (asset in idx)
            have_meta  = (meta in idx)
            if (have_asset && !have_meta)
                print "  " asset "\n      has no staged/tracked " meta
            else if (have_meta && !have_asset)
                print "  " meta "\n      has no staged/tracked asset beside it"
        }
    ' "$INDEX_LIST" "$PAIR_LIST")

    if [ -n "$PAIR_ERRORS" ]; then
        fail "pre-commit: asset/.meta pairs are broken by this commit."
        fail ""
        fail "$PAIR_ERRORS"
        fail ""
        fail "  Stage both halves. If the .meta does not exist yet, it is"
        fail "  generated by a build - see docs/WORKFLOW.md section 9,"
        fail "  'New-file sequence'."
    fi
fi

# ---------------------------------------------------------------------------
# 2. Staged PowerShell stays pure ASCII outside comments.
#
# The scripts have no BOM, so PowerShell 5.1 reads them as Windows-1252. The
# third byte of a UTF-8 em-dash decodes to a double quote, which closes a string
# literal early and produces a parse error pointing at an unrelated line - the
# worst kind of failure to debug, because the error names the wrong place.
#
# Comment lines are exempt: a dash in a `#` line never reaches the parser as
# string content, and run_tests_parallel.ps1 has seven such lines today. A
# trailing comment on a code line is still flagged, which is conservative on
# purpose - distinguishing a comment `#` from one inside a string needs a real
# parser, and being wrong in the permissive direction is what this check exists
# to prevent.
# ---------------------------------------------------------------------------

git diff --cached --name-only --diff-filter=ACMR -- '*.ps1' > "$TMPDIR_HOOK/ps1"
while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    hits=$(LC_ALL=C grep -n "[^ -~$TAB]" "$f" | grep -v "^[0-9]*:[[:space:]]*#")
    if [ -n "$hits" ]; then
        fail "pre-commit: non-ASCII outside a comment in $f"
        fail ""
        printf '%s\n' "$hits" | sed 's/^/      /' >&2
        fail ""
        fail "  PowerShell 5.1 reads these files as Windows-1252. Replace the"
        fail "  character with ASCII, or move it into a # comment."
    fi
done < "$TMPDIR_HOOK/ps1"

exit $FAIL
